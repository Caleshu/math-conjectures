  "method_claims": [
   {
    "claim": "The Pepin decision is exact.",
    "author_support": "proved_here",
    "justification": "For $n=0$, $F_0=3$. For $n\\ge1$, $F_n\\equiv5\\pmod{12}$. If prime, quadratic reciprocity gives $(3/F_n)=-1$, so Euler\u2019s criterion gives residue $-1$. Conversely, that residue implies for each prime $p\\mid F_n$ that the order of $3$ modulo $p$ divides $F_n-1$ and does not divide $(F_n-1)/2$. Since $F_n-1$ is a power of two, this order is $F_n-1$, forcing $p\\ge F_n$."
   },
   {
    "claim": "The first proper divisor in the consecutive scan is the least prime factor.",
    "author_support": "proved_here",
    "justification": "For $n\\ge2$ and prime $p\\mid F_n$, $2^{2^n}\\equiv-1\\pmod p$, so the order of $2$ is $2^{n+1}$. Hence $p\\equiv1\\pmod8$. The supplementary law for $2$ and Euler\u2019s criterion then imply that the order divides $(p-1)/2$. Thus $2^{n+2}\\mid p-1$, so the scan includes the least prime factor before any larger divisor. Any separately verified proper divisor below the bound also bounds the least prime factor from above."
   }
  ]
 }
}