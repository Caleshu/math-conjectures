# MathResearchLab backend configuration. Copy to .env (repo root or backend/) and fill in what you have.
# Every integration is optional; the Settings page shows what is configured.

# --- Database -------------------------------------------------------------------------
# Supabase: Project Settings -> Database -> Connection string (URI). Use the session pooler (port 5432)
# or direct connection. Leave empty to use a local SQLite file at backend/data/mathresearchlab.db.
DATABASE_URL=

# --- Auth (Supabase Auth) ---------------------------------------------------------------
SUPABASE_URL=                  # https://<ref>.supabase.co  (used to fetch JWKS for token verification)
SUPABASE_JWT_SECRET=           # only for projects still using the legacy HS256 JWT secret
REQUIRE_AUTH=false             # true = every /api route needs a valid Supabase access token

# --- AI providers -------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
CLAUDE_CODE_ENABLED=true       # use the local `claude` CLI on your Claude subscription (no API billing)
CLAUDE_CODE_PATH=claude
CLAUDE_CODE_MODEL=opus         # alias or full model name passed to `claude --model`
CLAUDE_CODE_TIMEOUT_S=1800
DEFAULT_LLM_PROVIDER=auto      # auto | anthropic | claude_code | openai
LLM_BUDGET_USD=25              # hard cap on recorded model spend; calls are refused beyond it

# --- Literature sources -------------------------------------------------------------------
SEMANTIC_SCHOLAR_API_KEY=      # optional; without it requests share a heavily rate-limited pool
CONTACT_EMAIL=                 # optional; sent to OpenAlex/Crossref "polite pool" if you set it
GROBID_URL=                    # e.g. http://localhost:8070 ; empty = pdfminer text extraction

# --- Jobs and sandbox -----------------------------------------------------------------------
RUN_EMBEDDED_WORKER=true       # false = run `python -m app.jobs.worker` separately
SANDBOX_DEFAULT_TIMEOUT_S=120
SANDBOX_MAX_TIMEOUT_S=1800
SANDBOX_DEFAULT_MEMORY_MB=2048
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
